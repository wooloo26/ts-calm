{
  "name": "@ts-calm/workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Private template workspace for TypeScript projects: functional runtime, check tool and the project's own toolchain.",
  "homepage": "https://github.com/wooloo26/ts-calm#readme",
  "bugs": "https://github.com/wooloo26/ts-calm/issues",
  "license": "MIT",
  "author": "wooloo26",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wooloo26/ts-calm.git"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run --config vitest.bench.config.ts",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint --type-aware .",
    "check": "node --conditions=source packages/check/src/cli.b.ts check",
    "commit-message": "node --conditions=source packages/check/src/cli.b.ts commit-message",
    "docs": "node --conditions=source packages/check/scripts/docs.ts",
    "verify": "pnpm build && pnpm typecheck && pnpm check && pnpm lint && pnpm fmt:check && pnpm test"
  },
  "devDependencies": {
    "@ts-calm/check": "workspace:*",
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "5.0.1",
    "lefthook": "2.1.14",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "turbo": "2.11.4",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0"
}
