{
  "name": "@ts-calm/check",
  "version": "0.1.0",
  "description": "Source-rule checking and pinned-compiler typechecking for TypeScript projects, with reusable APIs.",
  "keywords": [
    "architecture",
    "boundary",
    "check",
    "typecheck",
    "typescript"
  ],
  "homepage": "https://github.com/wooloo26/ts-calm#readme",
  "bugs": "https://github.com/wooloo26/ts-calm/issues",
  "license": "MIT",
  "author": "wooloo26",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wooloo26/ts-calm.git",
    "directory": "packages/check"
  },
  "bin": {
    "ts-calm": "./dist/cli.b.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "imports": {
    "#src/*": {
      "source": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "#tests/*": "./tests/*.ts"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ts-calm/fp": "workspace:*",
    "oxc-parser": "0.150.0",
    "oxc-resolver": "11.24.2",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24"
  }
}
