{
  "name": "ts-calm",
  "version": "0.1.0",
  "description": "Calm defaults, functional values and a complete TypeScript check command.",
  "keywords": [
    "architecture",
    "boundary",
    "functional",
    "option",
    "result",
    "typescript"
  ],
  "homepage": "https://github.com/wooloo26/ts-calm#readme",
  "bugs": "https://github.com/wooloo26/ts-calm/issues",
  "license": "MIT",
  "author": "wooloo26",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wooloo26/ts-calm.git"
  },
  "bin": {
    "ts-calm": "./dist/check/cli.b.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "presets",
    "types",
    ".oxlintrc.json",
    ".oxfmtrc.json",
    "docs"
  ],
  "type": "module",
  "types": "./dist/fp/index.d.ts",
  "imports": {
    "#src/*": "./src/fp/*",
    "#fixtures/*": "./fixtures/fp/*"
  },
  "exports": {
    ".": {
      "types": "./dist/fp/index.d.ts",
      "import": "./dist/fp/index.js"
    },
    "./boundary": {
      "types": "./dist/fp/boundary.d.ts",
      "import": "./dist/fp/boundary.js"
    },
    "./check": {
      "types": "./dist/check/index.d.ts",
      "import": "./dist/check/index.js"
    },
    "./oxlint": {
      "types": "./dist/check/oxlint.b.d.ts",
      "import": "./dist/check/oxlint.b.js"
    },
    "./oxfmt": {
      "types": "./dist/check/oxfmt.b.d.ts",
      "import": "./dist/check/oxfmt.b.js"
    },
    "./tsconfig.json": "./presets/tsconfig.strict.json",
    "./tsconfig.node.json": "./presets/tsconfig.node.json",
    "./node": {
      "types": "./types/node.d.ts"
    }
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "node src/check/cli.b.ts check",
    "verify": "pnpm check && pnpm test && pnpm build",
    "test:package": "node scripts/package-smoke.ts",
    "prepack": "pnpm build",
    "lint": "node src/check/cli.b.ts lint",
    "docs": "node scripts/docs.ts && oxfmt --write docs/rules.md"
  },
  "dependencies": {
    "@types/node": "24.13.6",
    "oxc-parser": "0.150.0",
    "oxc-resolver": "11.24.2",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "fast-check": "4.10.1",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0"
}
