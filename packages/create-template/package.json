{
  "name": "@ts-calm/create-template",
  "version": "0.1.0",
  "description": "Generate a private pnpm + Turbo TypeScript workspace that uses the @ts-calm packages.",
  "keywords": [
    "create",
    "template",
    "turbo",
    "typescript",
    "workspace"
  ],
  "homepage": "https://github.com/wooloo26/ts-calm#readme",
  "bugs": "https://github.com/wooloo26/ts-calm/issues",
  "license": "MIT",
  "author": "wooloo26",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wooloo26/ts-calm.git",
    "directory": "packages/create-template"
  },
  "bin": {
    "ts-calm-workspace": "./dist/cli.b.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ts-calm/fp": "workspace:*",
    "oxfmt": "0.68.0"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24"
  }
}
